# =====================================================================
# PathPilot Environment Configuration
# =====================================================================

# 1. Supabase Backend (Authentication, Database Storage, Session Sync)
# Create a free project at https://supabase.com
# Copy Project URL and Anon Public API key from Project Settings > API:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Google Gemini AI API (Server-Side Only — NEVER prefix with VITE_)
# Used by server/aiCompanionPlugin.js for live AIRA AI mentor responses.
# Get a Gemini API key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# 3. Server-Side Email Delivery (OTP Verification — NEVER prefix with VITE_)
# Option A: Resend API (recommended)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM=PathPilot <onboarding@yourdomain.com>
#
# Option B: SendGrid API
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
# EMAIL_FROM=no-reply@yourdomain.com
#
# Option C: Standard SMTP (Gmail / Outlook / Custom SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=PathPilot <your-email@gmail.com>

# Note: PathPilot features an automatic offline/local persistence fallback.
# When keys are not supplied or left as placeholders, the platform runs
# seamlessly in pre-calibrated Demo Mode with server-side mail spooling.
